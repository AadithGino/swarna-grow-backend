{
  "name": "swarnagrow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant gold savings platform API implementing the SwarnaGrow v1.2 contract",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.js",
    "dev:api": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "worker": "node --env-file=.env src/workers/index.js",
    "scheduler": "node --env-file=.env src/schedulers/index.js",
    "check": "node scripts/check-syntax.js && node scripts/check-route-coverage.js && npm run lint",
    "lint": "eslint src tests scripts",
    "test": "NODE_ENV=test node --test --test-concurrency=1 --test-reporter=spec",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:demo": "node --env-file=.env scripts/seed-demo.js",
    "seed:collection-agent": "node --env-file=.env scripts/seed-collection-agent.js",
    "cleanup:customer-dob": "node --env-file=.env scripts/unset-customer-dob.js",
    "db:sync-indexes": "node --env-file=.env scripts/sync-indexes.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.6",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.4",
    "ulid": "^3.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4"
  }
}
