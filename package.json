{
  "name": "swarnagrow-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant gold savings platform API implementing the SwarnaGrow v1.2 contract",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node --env-file=.env scripts/dev.js",
    "dev:api": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "worker": "node --env-file=.env src/workers/index.js",
    "scheduler": "node --env-file=.env src/schedulers/index.js",
    "check": "node scripts/check-syntax.js && node scripts/check-route-coverage.js && npm run lint",
    "package:export": "node scripts/package-source-export.mjs",
    "package:verify": "node scripts/verify-source-export-manifest.mjs",
    "lint": "eslint src tests scripts",
    "test": "NODE_ENV=test node --test --test-concurrency=1 --test-reporter=spec",
    "test:release": "RUN_HEAVY=1 NODE_ENV=test node --test --test-concurrency=1 --test-reporter=spec",
    "test:hardening": "node scripts/run-hardening-tests.js",
    "test:phase-e": "node scripts/run-phase-e-tests.js",
    "test:phase-f": "node scripts/run-phase-f-tests.js",
    "test:phase-ef-closure": "node scripts/run-phase-ef-closure-tests.js",
    "test:phase-ef-closure-no-15k": "node scripts/run-phase-ef-closure-no-15k.js",
    "test:phase-f-corrective": "node scripts/run-phase-f-corrective-tests.js",
    "test:phase-g1": "node scripts/run-phase-g1-tests.js",
    "load:hardening": "node --env-file=.env scripts/production-load-hardening.js",
    "load:fcm-15k-mock": "node scripts/fcm-staging-15k.js --dry-run=true --recipients=15000",
    "test:coverage": "node --test --test-concurrency=1 --experimental-test-coverage",
    "seed": "node --env-file=.env scripts/seed.js",
    "seed:demo": "node --env-file=.env scripts/seed-demo.js",
    "seed:ecommerce-demo": "node --env-file=.env scripts/seed-ecommerce-demo.js",
    "diagnose:ecommerce-payments": "node --env-file=.env scripts/diagnose-ecommerce-payment-capability.js",
    "ecommerce:payment-test-ui": "node scripts/run-ecommerce-payment-test-ui.js",
    "ecommerce:payment-test-ui:smoke": "node scripts/run-ecommerce-payment-test-ui.js --smoke",
    "seed:ritu-gold": "node --env-file=.env scripts/seed-ritu-gold-demo.js",
    "seed:coverage": "node --env-file=.env scripts/seed-platform-coverage.js",
    "seed:collection-agent": "node --env-file=.env scripts/seed-collection-agent.js",
    "seed:pending-handover": "node --env-file=.env scripts/seed-pending-handover-kairali.js",
    "seed:tenant-coverage-gaps": "node --env-file=.env scripts/seed-tenant-coverage-gaps.js",
    "audit:tenant-report-kpi-contract": "node --env-file=.env scripts/audit-tenant-report-kpi-contract.js",
    "test:tenant-coverage": "npm run seed:pending-handover && FRONTEND_BASE=http://localhost:5173 API_BASE=http://localhost:4000/api/v1 npx playwright test scripts/visual-tenant-coverage.spec.js --reporter=line --workers=1",
    "test:tenant-ui-parity": "npm run seed:pending-handover && npm run seed:tenant-coverage-gaps && FRONTEND_BASE=http://localhost:5173 API_BASE=http://localhost:4000/api/v1 npx playwright test scripts/audit-tenant-ui-parity.spec.js --reporter=line --workers=1",
    "cleanup:customer-dob": "node --env-file=.env scripts/unset-customer-dob.js",
    "seed:active-customer-counters": "node --env-file=.env scripts/seed-active-customer-counters.js",
    "db:sync-indexes": "node --env-file=.env scripts/sync-indexes.js --apply",
    "db:sync-indexes:dry-run": "node --env-file=.env scripts/sync-indexes.js --dry-run",
    "ops:inspect": "node --env-file=.env scripts/ops-inspect.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/s3-request-presigner": "^3.1134.0",
    "@phonepe-pg/pg-sdk-node": "^2.0.6",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.6",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dayjs": "^1.11.18",
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.0",
    "pdfkit": "^0.20.2",
    "pino": "^9.9.4",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.4",
    "ulid": "^3.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4"
  }
}
