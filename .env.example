NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
APP_TIMEZONE=Asia/Kolkata
MONGODB_URI=mongodb://127.0.0.1:27017/swarnagrow?replicaSet=rs0
MONGODB_MAX_POOL_SIZE=50
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
RATE_LIMIT_ENABLED=true
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
INTEGRATION_ENCRYPTION_KEY=replace-with-a-stable-32-character-key
JWT_WEB_TTL=30m
JWT_MOBILE_TTL=60m
REFRESH_TOKEN_DAYS=365
# Include the Vercel customer/bridge host so Flutter redirectUrl is accepted (https origin only).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://swarnagrow-tenant-admin.vercel.app
PUBLIC_BASE_URL=http://localhost:4000
EXPORT_BASE_URL=http://localhost:4000
TRUST_PROXY=1
LOG_LEVEL=info
PROVIDER_MODE=mock
ECOMMERCE_PAYMENTS_ROLLOUT_ENABLED=false
ECOMMERCE_PAYMENTS_TEST_HARNESS=false
ECOMMERCE_PAYMENT_RECONCILE_GRACE_MS=300000
ECOMMERCE_PAYMENT_RECONCILE_BATCH_SIZE=50
ECOMMERCE_PAYMENT_RECONCILE_LEASE_MS=120000
ECOMMERCE_PAYMENT_RECONCILE_MAX_ATTEMPTS=12
PHONEPE_ENV=SANDBOX
PHONEPE_UPI_INTENT_ONLY=false
PHONEPE_UPI_APPS=phonepe,gpay,paytm
PHONEPE_UPI_FLOWS=INTENT
WHATSAPP_BASE_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
OTP_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=30
OTP_MAX_ATTEMPTS=5
OTP_MC_VERIFY_LEASE_MS=45000
OTP_SESSION_ISSUE_LEASE_MS=120000
OTP_SEND_INFLIGHT_LEASE_MS=30000
OTP_BUDGET_WINDOW_SECONDS=900
OTP_BUDGET_MAX_PER_DESTINATION=30
OTP_BUDGET_MAX_PER_IP=120
OTP_BUDGET_MAX_PER_TENANT=200
OTP_BUDGET_MAX_PER_PROVIDER=2000
MESSAGE_CENTRAL_BASE_URL=https://cpaas.messagecentral.com
MESSAGE_CENTRAL_TIMEOUT_MS=8000
MESSAGE_CENTRAL_PLATFORM_CUSTOMER_ID=
MESSAGE_CENTRAL_PLATFORM_KEY=
MESSAGE_CENTRAL_PLATFORM_AUTH_TOKEN=
MESSAGE_CENTRAL_PLATFORM_EMAIL=
MESSAGE_CENTRAL_CUSTOMER_ID=
MESSAGE_CENTRAL_AUTH_TOKEN=
MESSAGE_CENTRAL_EMAIL=
MESSAGE_CENTRAL_PLATFORM_COUNTRY_CODE=91
MESSAGE_CENTRAL_PLATFORM_OTP_LENGTH=6
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_SENDER_ID=
MSG91_OTP_VAR=otp
MSG91_DEFAULT_COUNTRY_CODE=91
MSG91_SMS_TIMEOUT_MS=8000
# S3-compatible object storage (AWS: leave S3_ENDPOINT empty). Aliases AWS_REGION, AWS_S3_BUCKET, AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_S3_PREFIX also work.
S3_REGION=ap-south-1
S3_BUCKET=
S3_KEY_PREFIX=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MALWARE_SCAN_URL=
MALWARE_SCAN_API_KEY=
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
FCM_SHARED_PROJECT_ENABLED=false
FCM_SEND_CONCURRENCY=32
FCM_REQUEST_TIMEOUT_MS=15000
FCM_MAX_ATTEMPTS=3
FCM_RETRY_BASE_MS=500
FCM_MAX_DEVICES_PER_PRINCIPAL=10
FCM_MULTICAST_BATCH_SIZE=500
FCM_RATE_LIMIT_GLOBAL_PER_SEC=200
FCM_RATE_LIMIT_GLOBAL_BURST=400
FCM_RATE_LIMIT_TENANT_PER_SEC=80
FCM_RATE_LIMIT_TENANT_BURST=160
FCM_RATE_LIMIT_KEY_TTL_SEC=3600
FCM_RATE_LIMIT_REDIS_UNAVAILABLE_MS=5000
FCM_DELIVERY_CLAIM_MS=120000
PHONEPE_REQUEST_TIMEOUT_MS=20000
PHONEPE_RECONCILE_BATCH_SIZE=50
PHONEPE_RECONCILE_STALE_SECONDS=900
PHONEPE_RECONCILE_MAX_ATTEMPTS=5
PHONEPE_RECONCILE_LEASE_MS=120000
WEBHOOK_MAX_BODY_BYTES=2097152
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000
WEBHOOK_RATE_LIMIT_PER_TENANT=600
WEBHOOK_RATE_LIMIT_PER_IP=1200
WEBHOOK_PROCESSING_LEASE_MS=300000
WEBHOOK_SIGNATURE_FAILURE_RETENTION_SEC=86400
WEBHOOK_RAW_RETENTION_SEC=604800
WEBHOOK_COMPLETED_RETENTION_SEC=2592000
MESSAGE_DISPATCH_BATCH_SIZE=250
MESSAGE_DISPATCH_TENANT_BATCH_SIZE=50
MESSAGE_DISPATCH_TENANT_PAGE_SIZE=32
MESSAGE_DISPATCH_TENANT_QUERY_CONCURRENCY=4
REMINDER_MAX_SCHEME_BATCHES_PER_TENANT_PER_RUN=5
REMINDER_MAX_SCHEMES_PER_TENANT_PER_RUN=500
PAYMENT_EXPIRY_BATCH_SIZE=100
PAYMENT_EXPIRY_MAX_BATCHES_PER_RUN=20
MAINTENANCE_CURSOR_TTL_SEC=604800
MAINTENANCE_SCAN_LEASE_MS=120000
SCHEDULER_JOB_ATTEMPTS=3
SCHEDULER_JOB_BACKOFF_MS=30000
PAYMENTS_JOB_ATTEMPTS=5
PAYMENTS_JOB_BACKOFF_MS=15000
MAINTENANCE_JOB_ATTEMPTS=5
MAINTENANCE_JOB_BACKOFF_MS=15000
WEBHOOK_RECLAIM_BATCH_SIZE=100
WEBHOOK_RECLAIM_MAX_BATCHES_PER_RUN=10
SCHEDULER_REQUIRE_WORKER_ROLES=false
MESSAGE_DISPATCH_LEASE_MS=120000
MESSAGE_DISPATCH_DISPATCHED_STALE_MS=900000
DISPATCH_RECLAIM_BATCH_SIZE=200
LEGACY_MESSAGE_SEND_OUTBOX_BATCH_SIZE=200
SCHEME_MAINTENANCE_BATCH_SIZE=200
SCHEME_MAINTENANCE_MAX_BATCHES_PER_RUN=50
REMINDER_SCHEDULER_MAX_TENANT_BATCHES_PER_RUN=20
REPORT_MAX_SYNC_ROWS=5000
REPORT_EXPORT_MAX_ROWS=200000
REPORT_EXPORT_MAX_BYTES=52428800
REPORT_EXPORT_MAX_RUNTIME_MS=600000
REPORT_EXPORT_MAX_CONCURRENT_PER_TENANT=3
REPORT_EXPORT_DOWNLOAD_TTL_MS=900000
REPORT_EXPORT_ARTIFACT_RETENTION_MS=604800000
READINESS_MESSAGE_QUEUE_LAG_MS=300000
READINESS_WEBHOOK_QUEUE_WAITING_MAX=500
READINESS_WEBHOOK_EVENT_BACKLOG_MAX=1000
READINESS_WEBHOOK_DEAD_LETTER_MAX=50
MESSAGE_WORKER_CONCURRENCY=40
PUSH_BROADCAST_CHUNK_SIZE=400
PUSH_BROADCAST_LEASE_MS=120000
PUSH_BROADCAST_MAX_CHUNK_ATTEMPTS=12
FCM_DEFAULT_TTL_SEC=86400
REMINDER_SCHEME_BATCH_SIZE=100
REMINDER_TENANT_BATCH_SIZE=50
REMINDER_SCHEDULER_LEASE_MS=300000
# 0 = unlimited (bounded by tenant subscription activeCustomers)
PUSH_BROADCAST_MAX_RECIPIENTS=0
SEED_PLATFORM_MOBILE=+919999999999
SEED_PLATFORM_EMAIL=ops@platform.com
SEED_PLATFORM_PASSWORD=1234
# Analytics Sidekick (disabled until GEMINI_API_KEY is set)
ASSISTANT_ENABLED=false
GEMINI_API_KEY=
# New Google AI keys often reject 2.5-* models (404); use gemini-3.5-flash-lite if Sidekick fails.
ASSISTANT_MODEL=gemini-3.5-flash-lite
ASSISTANT_LLM_TIMEOUT_MS=20000
ASSISTANT_ENGINE=agent
ASSISTANT_MAX_STEPS=5
ASSISTANT_DAILY_QUESTION_LIMIT=300
ASSISTANT_TEMPERATURE=
ASSISTANT_THINKING_LEVEL=
ASSISTANT_PRICE_INPUT_PER_M=
ASSISTANT_PRICE_OUTPUT_PER_M=
ASSISTANT_PRICE_CACHED_PER_M=
# Vercel cron handlers (Phase 4 will require in production); never commit real values
CRON_SECRET=
