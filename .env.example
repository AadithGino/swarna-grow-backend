INTEGRATION_ENCRYPTION_KEY=REPLACE_ME_INTEGRATION_ENCRYPTION_KEY!!
JWT_WEB_TTL=30m
JWT_MOBILE_TTL=60m
REFRESH_TOKEN_DAYS=365
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=1
PROVIDER_MODE=mock
