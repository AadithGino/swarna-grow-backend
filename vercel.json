{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "installCommand": "npm install",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/cron/keep-warm.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/cron/queue-tick.js": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/health", "destination": "/api" },
    { "source": "/health/:path*", "destination": "/api" },
    { "source": "/mock-storage/:path*", "destination": "/api" },
    { "source": "/api/v1/:path*", "destination": "/api" },
    { "source": "/api/v1", "destination": "/api" }
  ]
}
