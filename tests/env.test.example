# Synthetic isolated test configuration (copy to tests/.env.test.local or export before npm test).
# Do not point at production MongoDB, Redis, or provider credentials.

NODE_ENV=test
LOG_LEVEL=error
JWT_ACCESS_SECRET=test-access-secret-32-characters-min!!
JWT_REFRESH_SECRET=test-refresh-secret-32-characters-min!
INTEGRATION_ENCRYPTION_KEY=test-integration-key-32-chars!!
REDIS_URL=redis://127.0.0.1:6379/15
REDIS_REQUIRED=false
RATE_LIMIT_ENABLED=true
PROVIDER_MODE=mock
OTP_PROVIDER=mock
PHONEPE_ENV=SANDBOX
MONGODB_URI=mongodb://127.0.0.1:27017/swarnagrow_test_isolated?replicaSet=rs0
# MongoMemoryServer: optional pin when CDN download fails (see evidence/remediation/environment-preflight.md)
# MONGOMS_VERSION=7.0.14
# MONGOMS_DISTRO=ubuntu-22.04
